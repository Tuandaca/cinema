# ========================================================
# 🎬 CoiCine Monorepo - Master Environment Variables Example
# ========================================================
# Hướng dẫn: Tạo bản sao file này thành .env (hoặc .env.local trong apps/web)
# và điền các giá trị thực tế tương ứng với môi trường của bạn.

# --------------------------------------------------------
# 🌐 Server & Network Configuration (apps/api)
# --------------------------------------------------------
NODE_ENV="development"
PORT=3001
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --------------------------------------------------------
# 🗄️ Database (Supabase PostgreSQL via Prisma ORM)
# --------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres"

# --------------------------------------------------------
# 🔐 Authentication & Security (JWT)
# --------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# --------------------------------------------------------
# ⚡ Redis Cache & Seat Locking (With In-Memory Fallback)
# --------------------------------------------------------
# Fallback mặc định là redis://localhost:6379 nếu không kết nối được.
REDIS_URL="redis://localhost:6379"
# UPSTASH_REDIS_URL="rediss://default:xxxxx@global-xxxxx.upstash.io:6379"

# --------------------------------------------------------
# 💳 VietQR Napas 247 Banking Transfer (Payment Gateway)
# --------------------------------------------------------
# Cấu hình chuyển khoản liên ngân hàng Napas 247 qua mã VietQR chuẩn ngân hàng
VIETQR_BANK_ID="970436"                                # Vietcombank (970436), MBBank (970422), Techcombank (970407)
VIETQR_ACCOUNT_NO="1028472918"                         # Số tài khoản ngân hàng thụ hưởng
VIETQR_ACCOUNT_NAME="CONG TY TNHH COICINE VIETNAM"    # Tên chủ tài khoản (Viết hoa không dấu)
VIETQR_TEMPLATE="compact2"                             # Mẫu QR: compact2, qr_only, compact, print

# Tương thích ngược với các biến alias
BANK_BIN="970436"
ACCOUNT_NO="1028472918"
ACCOUNT_NAME="CONG TY TNHH COICINE VIETNAM"

# --------------------------------------------------------
# 💳 Stripe Live & Test (International Card Payment)
# --------------------------------------------------------
# Bỏ trống hoặc để chuỗi chứa "placeholder" để chạy chế độ Dev Mock Fallback
STRIPE_SECRET_KEY="your-stripe-secret-key-or-leave-empty-for-mock"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# Khóa công khai Stripe phía Frontend (apps/web)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key"

# --------------------------------------------------------
# 💳 PayOS Gateway (Automated Bank Transfer Webhooks)
# --------------------------------------------------------
PAYOS_CLIENT_ID="your-payos-client-id"
PAYOS_API_KEY="your-payos-api-key"
PAYOS_CHECKSUM_KEY="your-payos-checksum-key"

# --------------------------------------------------------
# 🤖 AI Assistant (Google Gemini 2.5 Flash via AI SDK)
# --------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# --------------------------------------------------------
# 🎞️ Movie Data & External Providers (Trakt & OMDb)
# --------------------------------------------------------
TRAKT_CLIENT_ID="your-trakt-client-id"
OMDB_API_KEY="your-omdb-api-key"

# --------------------------------------------------------
# ☁️ Cloudinary Media Storage (Posters & Backdrops)
# --------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --------------------------------------------------------
# 💻 Frontend Environment Variables (apps/web)
# --------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3006"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
